+        for index in elements.indices.reversed() {
+            let order = elements[index].order
+            if topmostIndex != nil, order <= topmostOrder { continue }
+            if elements[index].contains(point) {
+                topmostIndex = index
+                topmostOrder = order
+            }
+        }
+        return topmostIndex.map { elements[$0] }
     }
 
