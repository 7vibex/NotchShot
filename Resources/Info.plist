<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleName</key>
	<string>NotchShot</string>
	<key>CFBundleDisplayName</key>
	<string>NotchShot</string>
	<key>CFBundleExecutable</key>
	<string>NotchShot</string>
	<key>CFBundleIdentifier</key>
	<string>com.notchshot.app</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>LSMinimumSystemVersion</key>
	<string>26.0</string>

	<!-- Accessory app: menu-bar item and the notch, no Dock icon by default.
	     The Dock icon can be turned on at runtime via setActivationPolicy. -->
	<key>LSUIElement</key>
	<true/>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSSupportsAutomaticTermination</key>
	<false/>
	<key>NSSupportsSuddenTermination</key>
	<false/>

	<!-- Screen Recording has no usage-description key; macOS uses the app name.
	     These two are requested lazily, only when the feature is first used. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>NotchShot records your microphone only while you have microphone recording switched on for a screen recording.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>NotchShot can create an optional on-device transcript and caption file from a recording you make.</string>
	<key>NSAppleEventsUsageDescription</key>
	<string>NotchShot asks Music and Spotify what is playing, only as a fallback when the system Now Playing bridge is unavailable.</string>

	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>NotchShot Project</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSTypeIsPackage</key>
			<true/>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.notchshot.project</string>
			</array>
		</dict>
	</array>

	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.notchshot.project</string>
			<key>UTTypeDescription</key>
			<string>NotchShot Project</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>com.apple.package</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>notchshot</string>
				</array>
			</dict>
		</dict>
	</array>
</dict>
</plist>
