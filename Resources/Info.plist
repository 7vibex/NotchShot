<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleName</key>
	<string>NotchShot</string>
	<key>CFBundleDisplayName</key>
	<string>NotchShot</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
	</array>
	<key>NSHumanReadableCopyright</key>
	<string>Copyright © 2026 NotchShot. All rights reserved.</string>
	<key>CFBundleExecutable</key>
	<string>NotchShot</string>
	<key>CFBundleIdentifier</key>
	<string>com.notchshot.app</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.notchshot.automation</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>notchshot</string>
			</array>
		</dict>
	</array>
	<key>LSMinimumSystemVersion</key>
	<string>26.0</string>

	<!-- Accessory app: menu-bar item and the notch, no Dock icon by default.
	     The Dock icon can be turned on at runtime via setActivationPolicy. -->
	<key>LSUIElement</key>
	<true/>
	<key>LSMultipleInstancesProhibited</key>
	<true/>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSSupportsAutomaticTermination</key>
	<false/>
	<key>NSSupportsSuddenTermination</key>
	<false/>
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<key>SUAutomaticallyUpdate</key>
	<true/>

	<!-- Sensitive capabilities are requested lazily when their feature is used. -->
	<key>NSScreenCaptureUsageDescription</key>
	<string>NotchShot captures the screen only when you start a screenshot, text capture, or screen recording.</string>
	<key>NSAudioCaptureUsageDescription</key>
	<string>NotchShot captures system audio only while you record the screen with system audio switched on.</string>
	<key>NSDesktopFolderUsageDescription</key>
	<string>NotchShot saves captures to the Desktop only when it is your selected output folder.</string>
	<key>NSFocusStatusUsageDescription</key>
	<string>NotchShot can briefly show when a Focus turns on or off. macOS shares only whether a Focus is on, never which one.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>NotchShot records your microphone only when you start a screen recording with microphone audio, explicitly start a Voice Note, or use Notch Dictation to transcribe speech locally.</string>
	<key>NSCameraUsageDescription</key>
	<string>NotchShot uses the camera only while you open Presenter Camera or explicitly enable its visible recording overlay.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>NotchShot uses your local network only when you send selected files directly to a LocalSend receiver.</string>
	<key>NSServices</key>
	<array>
		<dict>
			<key>NSMenuItem</key>
			<dict>
				<key>default</key>
				<string>Add to NotchShot Shelf</string>
			</dict>
			<key>NSMessage</key>
			<string>addFilesToShelf</string>
			<key>NSPortName</key>
			<string>NotchShot</string>
			<key>NSServiceDescription</key>
			<string>Park selected files in the NotchShot shelf without copying or moving them.</string>
			<key>NSSendFileTypes</key>
			<array>
				<string>public.data</string>
			</array>
			<key>NSSendTypes</key>
			<array>
				<string>public.file-url</string>
			</array>
		</dict>
	</array>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>NotchShot performs speech recognition entirely on-device. A one-time language download may be required. Dictation audio is not saved and no transcript is stored by default; optional recording captions are created locally from a recording you make.</string>
	<key>NSAppleEventsUsageDescription</key>
	<string>NotchShot reads playback details from and sends playback controls to Music or Spotify when you enable the Apple Events fallback.</string>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>NotchShot reads upcoming events only when you enable Calendar Glance, and writes an event only after you preview it and press Add.</string>
	<key>NSCalendarsWriteOnlyAccessUsageDescription</key>
	<string>NotchShot adds a calendar event only after you preview the parsed title and time and press Add.</string>
	<key>NSRemindersFullAccessUsageDescription</key>
	<string>NotchShot adds a reminder only after you preview the parsed title and due time and press Add.</string>

	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>NotchShot Project</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSTypeIsPackage</key>
			<true/>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.notchshot.project</string>
			</array>
		</dict>
	</array>

	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.notchshot.project</string>
			<key>UTTypeDescription</key>
			<string>NotchShot Project</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>com.apple.package</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>notchshot</string>
				</array>
			</dict>
		</dict>
	</array>
</dict>
</plist>
